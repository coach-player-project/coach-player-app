        "/api/auth/logout": {
            "post": {
                "summary": "Wylogowanie użytkownika",
                "description": "Zamyka sesję użytkownika i unieważnia token dostępu",
                "operationId": "69281b12abb272c76871f19cb17ca563",
                "responses": {
                    "200": {
                        "description": "Wylogowano pomyślnie"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
