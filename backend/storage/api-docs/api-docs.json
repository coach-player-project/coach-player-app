{
    "openapi": "3.0.0",
    "info": {
        "title": "Football App API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "paths": {
        "/api/admin/users/{id}/role": {
            "put": {
                "summary": "Zmień rolę użytkownika",
                "description": "Pozwala administratorowi zmienić rolę dowolnego użytkownika (admin, coach, player)",
                "operationId": "a91dbccd21e1f5568d5713910140f31e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID użytkownika",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "required": [
                                    "role"
                                ],
                                "properties": {
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "admin",
                                            "coach",
                                            "player"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Rola pomyślnie zmieniona"
                    },
                    "404": {
                        "description": "Nie znaleziono użytkownika"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/register": {
            "post": {
                "summary": "Rejestracja użytkownika",
                "description": "Rejestruje nowego użytkownika w systemie",
                "operationId": "d764dd091cc4494ae0baf360b03319f3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "email",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "last_name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 8
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "coach",
                                            "player"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Użytkownik zarejestrowany pomyślnie"
                    },
                    "422": {
                        "description": "Błąd walidacji danych"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "summary": "Logowanie użytkownika",
                "description": "Authenticate user and issue token.",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "responses": {
                    "200": {
                        "description": "Pomyślnie zalogowano"
