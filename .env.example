# ─── Docker environment variables ────────────────────────────────────────────
# Copy this file to .env and adjust the values before running docker-compose

# PostgreSQL
DB_DATABASE=coach_player
DB_USERNAME=coach
DB_PASSWORD=secret

# Laravel app key (generated automatically on first run if left empty)
APP_KEY=

# Google calendar id and account key
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=